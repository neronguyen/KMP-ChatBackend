  "cards": [
    {
      "dot": "cyan",
      "title": "Contract-Driven Ingress",
      "items": [
        "ContractValidationAdvice automatically validates incoming DTOs implementing Validatable from KMP-ChatContract",
        "Exception handlers map domain failures to flat-wire ApiErrorDto and sealed ServerError codes"
      ]
    },
    {
      "dot": "emerald",
      "title": "Modular Monolith & Event Bus",
      "items": [
        "Domain modules (:user, :chat, :notification) communicate asynchronously via RabbitMQ topic exchanges",
        "UserEvent.Verified triggers chat participant provisioning; UserEvent.Created triggers verification emails"
      ]
    },
    {
      "dot": "rose",
      "title": "State & Rate Limiting",
      "items": [
        "Redisson enforces distributed IP and email rate limits and caches 30-minute message slices",
        "PostgreSQL persists user credentials, hashed refresh tokens, chat rooms, and UUIDv7 messages"
      ]
    }
  ]
