# ==============================================================================
# KMP-ChatBackend Production Environment Variables
# Copy to .env and fill in strong random values before running:
#   docker compose -f docker-compose.prod.yml up -d --build
# ==============================================================================

# --- Domain & TLS (Caddy) ---
# Point your domain (e.g. DuckDNS or custom domain) A record to the VM public IP.
DOMAIN=chat.example.com

# --- GitHub Packages (BuildKit secrets for resolving KMP-ChatContract) ---
GITHUB_ACTOR=your-github-username
GITHUB_TOKEN=ghp_replace_with_read_packages_pat

# --- Spring Profile & Hibernate ---
# Use 'update' + 'true' on first boot to create user_service/chat_service schemas
# before Flyway (CHAT-10) lands, then switch to 'validate' + 'false' on restarts.
JPA_DDL_AUTO=update
JPA_CREATE_NAMESPACES=true

# --- PostgreSQL ---
POSTGRES_DB=nerochat
POSTGRES_USERNAME=nerochat
POSTGRES_PASSWORD=replace_with_strong_postgres_password

# --- Redis / Redisson ---
# For local Docker Compose: REDIS_PROTOCOL=redis, REDIS_HOST=redis, REDIS_PORT=6379
# For managed TLS Redis (e.g. Redis Cloud / Upstash): REDIS_PROTOCOL=rediss
REDIS_PROTOCOL=redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=replace_with_strong_redis_password
REDIS_MIN_IDLE=2
REDIS_POOL_SIZE=5
REDIS_SUB_MIN_IDLE=1
REDIS_SUB_POOL_SIZE=5

# --- RabbitMQ ---
# For local Docker Compose: RABBITMQ_HOST=rabbitmq, RABBITMQ_PORT=5672, RABBITMQ_SSL_ENABLED=false
# For CloudAMQP AMQPS: RABBITMQ_PORT=5671, RABBITMQ_SSL_ENABLED=true
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_SSL_ENABLED=false
RABBITMQ_USERNAME=nerochat
RABBITMQ_PASSWORD=replace_with_strong_rabbitmq_password
RABBITMQ_VHOST=/

# --- Security Secrets ---
# Generate JWT_SECRET_BASE64 with: openssl rand -base64 64 | tr -d '\n'
JWT_SECRET_BASE64=replace_with_base64_encoded_64_byte_secret
# Generate OTP_PEPPER with: openssl rand -hex 32
OTP_PEPPER=replace_with_hex_32_byte_pepper

# --- Transactional Email (Brevo / Resend SMTP) ---
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=replace_with_smtp_login
SMTP_PASSWORD=replace_with_smtp_api_key
SMTP_SENDER=noreply@example.com
